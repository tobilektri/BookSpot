# Apache config for the document root (shared hosting). The domain may point to this
# "public" folder or to the project folder (see ../.htaccess).
Options -Indexes
DirectoryIndex index.html

# Own rewrite context: stops the forwarding rules of ../.htaccess from applying here.
# Shared hosts usually allow .htaccess in the whole web space, so with the domain pointing
# to public/ Apache would otherwise rewrite every request to public/public/… (404).
<IfModule mod_rewrite.c>
    RewriteEngine On
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType text/javascript .js .mjs
</IfModule>

# Never serve dotfiles (.user.ini, .htaccess …)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set X-Frame-Options "DENY"
    Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' https: data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

    <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
        ExpiresActive Off
    </FilesMatch>
</IfModule>

# Fallback when the domain points to the project root instead of /public
# (recommended: set the document root to the "public" folder).
Options -Indexes

<FilesMatch "^\.|\.(sql|sqlite|log|lock|md|json|xml|dist|yml|neon)$|^(Dockerfile|composer\..*)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(backend|vendor|var|tests|frontend|docker|node_modules)(/|$) - [F,L]
    # Forward to public/ unless the request is already there. Matching the path relative
    # to this folder (not REQUEST_URI) keeps this correct in sub-directory installs, too.
    RewriteRule ^public(/|$) - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

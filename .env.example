# ---------------------------------------------------------------------------
# BookSpot / SchmökerSpot configuration. Copy to .env and adjust.
# Real environment variables (e.g. from docker-compose) override this file.
# ---------------------------------------------------------------------------

# Optional display name override (default: "SchmökerSpot" in German, "BookSpot" in English)
APP_NAME=
# Public URL, used as contact in metadata API requests and as VAPID subject fallback
APP_URL=https://books.example.org
# production | development (development shows error details in API responses)
APP_ENV=production
APP_TIMEZONE=Europe/Berlin

# Database: mysql (MariaDB/MySQL, recommended) or sqlite (fallback, no server needed)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bookspot
DB_USER=bookspot
DB_PASS=change-me
# Only for DB_DRIVER=sqlite (relative to the project root)
DB_SQLITE_PATH=var/bookspot.sqlite

# The first account is always allowed (and becomes admin). Admins create further
# accounts in the web interface (Settings -> User management). Set to true to also
# allow self-registration on the login page (new accounts get the role "user").
ALLOW_REGISTRATION=false

# Sessions: auto = Secure cookie flag when the request is HTTPS
SESSION_SECURE=auto
SESSION_LIFETIME_DAYS=30

# Web cron (shared hosting): https://books.example.org/api/cron.php?token=<token>
# Leave empty: a random token is generated automatically; admins find the complete
# URL under Settings -> Cron job. Set it here only if you want a fixed token (min. 16 chars).
CRON_TOKEN=

# Invitation emails (Settings -> User management) are sent with PHP mail().
# Sender, e.g. "SchmökerSpot <noreply@books.example.org>" – use an address of your own
# domain, otherwise many providers reject the mail. Default: noreply@<host>.
MAIL_FROM=
MAIL_REPLY_TO=
# How long an invitation link stays valid
INVITE_VALID_DAYS=7

# Web Push (VAPID). Leave empty: keys are generated once and stored in the database.
# Or generate with: php backend/bin/vapid.php
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org

# Metadata lookup: Open Library -> Deutsche Nationalbibliothek -> Google Books
# (later sources only fill fields that are still empty)
METADATA_LOOKUP=true
# Deutsche Nationalbibliothek (free, no key, very good for German editions)
METADATA_DNB=true
# Google Books only works with your own (free) API key – without it Google answers 429.
# How to create one: docs/google-books-api-key.md
GOOGLE_BOOKS_API_KEY=
CRON_ENRICH_METADATA=true
CRON_ENRICH_BATCH=20
# Covers are downloaded once and stored in var/covers/ (include it in backups)
CRON_COVER_BATCH=40
# Bulk scan: placeholders whose metadata is looked up per cron run (the app also works off the
# queue while the scanner is open)
CRON_QUEUE_BATCH=30
# Covers are only downloaded from public internet hosts (protection against requests to
# internal services). Set to true only if your covers live on a server in your own network.
COVER_ALLOW_PRIVATE_HOSTS=false

# --- Rate limits ---
# Requests to the external metadata/cover sources (requests per second, shared by all users).
# Lookups wait briefly for a free slot; a source that answers 429 is paused (Retry-After or
# 1, 2, 4 … 60 minutes) and the next source is used instead.
RATE_LIMIT_OPEN_LIBRARY=1
RATE_LIMIT_DNB=2
RATE_LIMIT_GOOGLE_BOOKS=5
# Open Library covers by ISBN: 100 per 5 minutes and IP are allowed
RATE_LIMIT_OPEN_LIBRARY_COVERS=0.33
# API requests per minute and IP (cover images are not counted); 0 = off
RATE_LIMIT_REQUESTS_PER_MINUTE=600

# Other web front-ends that may call the API with the user's session (exact origins, comma
# separated, e.g. https://books.example.org). Empty = same origin only (recommended).
CORS_ALLOWED_ORIGINS=

# Extra comma separated "genres" to ignore during CSV import (in addition to the built-in list)
IMPORT_GENRE_BLOCKLIST=

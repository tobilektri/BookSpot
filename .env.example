# ---------------------------------------------------------------------------
# BookSpot / SchmökerSpot configuration. Copy to .env and adjust.
# Real environment variables (e.g. from docker-compose) override this file.
# ---------------------------------------------------------------------------

# Optional display name override (default: "SchmökerSpot" in German, "BookSpot" in English)
APP_NAME=
# Public URL, used as contact in metadata API requests and as VAPID subject fallback
APP_URL=https://books.example.org
# production | development (development shows error details in API responses)
APP_ENV=production
APP_TIMEZONE=Europe/Berlin

# Database: mysql (MariaDB/MySQL, recommended) or sqlite (fallback, no server needed)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bookspot
DB_USER=bookspot
DB_PASS=change-me
# Only for DB_DRIVER=sqlite (relative to the project root)
DB_SQLITE_PATH=var/bookspot.sqlite

# The first account is always allowed (and becomes admin). Afterwards:
ALLOW_REGISTRATION=false

# Sessions: auto = Secure cookie flag when the request is HTTPS
SESSION_SECURE=auto
SESSION_LIFETIME_DAYS=30

# Web cron (shared hosting): https://books.example.org/api/cron.php?token=<CRON_TOKEN>
# Generate e.g. with: php -r "echo bin2hex(random_bytes(24));"
CRON_TOKEN=

# Web Push (VAPID). Leave empty: keys are generated once and stored in the database.
# Or generate with: php backend/bin/vapid.php
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org

# Metadata lookup (Open Library, fallback Google Books)
METADATA_LOOKUP=true
GOOGLE_BOOKS_API_KEY=
CRON_ENRICH_METADATA=true
CRON_ENRICH_BATCH=20

# Extra comma separated "genres" to ignore during CSV import (in addition to the built-in list)
IMPORT_GENRE_BLOCKLIST=
